/* style.css */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Poppins,sans-serif;

  background: linear-gradient(
  135deg,
  #fff7c2,
  #ffe066,
  #ffffff
  );

  background-size:400% 400%;
  animation:bgMove 8s ease infinite;

  overflow:hidden;
}

.screen{
  width:100%;
  height:100vh;

  display:none;

  flex-direction:column;
  justify-content:center;
  align-items:center;

  padding:20px;

  text-align:center;
}

.active{
  display:flex;
}

.title{
  font-size:28px;
  color:#222;
  margin-bottom:20px;
}

.cake{
  width:260px;
  animation:float 2s infinite ease-in-out;

  filter:drop-shadow(0px 10px 20px rgba(0,0,0,0.2));
}

.knife{
  width:120px;
  margin-top:20px;

  animation:knifeMove 2s infinite;
}

button{
  margin-top:30px;

  padding:15px 25px;

  border:none;
  border-radius:50px;

  background:#ff4d8d;
  color:white;

  font-size:18px;
  font-weight:bold;

  cursor:pointer;

  box-shadow:0px 5px 15px rgba(0,0,0,0.2);
}

button:active{
  transform:scale(0.95);
}

.funnyText{
  font-size:35px;
  color:#222;
}

.smallText{
  margin-top:15px;
  color:#444;
  font-size:18px;
}

.btnGroup{
  display:flex;
  gap:20px;
  margin-top:30px;
}

#monkeyPopup{
  position:fixed;
  inset:0;

  background:rgba(0,0,0,0.9);

  display:none;

  flex-direction:column;
  justify-content:center;
  align-items:center;

  z-index:999;
}

.monkey{
  width:260px;

  border-radius:20px;

  animation:zoom 0.5s;
}

#monkeyPopup h2{
  color:white;
  margin-top:20px;
  font-size:30px;
}

.puzzleTitle{
  color:#222;
  margin-bottom:25px;
}

.puzzleGrid{
  width:300px;

  display:grid;
  grid-template-columns:repeat(3,1fr);

  gap:6px;
}

.piece{
  width:95px;
  height:95px;

  background:#ff4d8d;

  display:flex;
  justify-content:center;
  align-items:center;

  font-size:30px;
  font-weight:bold;

  color:white;

  border-radius:15px;
}

.empty{
  background:#fff;
}

.galleryTitle{
  color:#222;
  margin-bottom:25px;
}

.gallery{
  width:100%;

  display:grid;
  grid-template-columns:1fr 1fr;

  gap:10px;
}

.gallery img{
  width:100%;
  height:180px;

  object-fit:cover;

  border-radius:20px;

  box-shadow:0px 5px 15px rgba(0,0,0,0.2);
}

/* ANIMATIONS */

@keyframes float{

  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-15px);
  }

  100%{
    transform:translateY(0px);
  }

}

@keyframes knifeMove{

  0%{
    transform:rotate(0deg);
  }

  50%{
    transform:rotate(10deg);
  }

  100%{
    transform:rotate(0deg);
  }

}

@keyframes zoom{

  from{
    transform:scale(0);
  }

  to{
    transform:scale(1);
  }

}

@keyframes bgMove{

  0%{
    background-position:0% 50%;
  }

  50%{
    background-position:100% 50%;
  }

  100%{
    background-position:0% 50%;
  }

}

/* MOBILE */

@media(max-width:600px){

  .title{
    font-size:24px;
  }

  .funnyText{
    font-size:28px;
  }

  .gallery img{
    height:150px;
  }

  .btnGroup{
    flex-direction:column;
  }

}
